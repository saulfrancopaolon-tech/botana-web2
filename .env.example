# --- Ya las tenías (Supabase público, se usan en el navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Nuevas, para el panel de staff (/staff) ---
# SOLO se usan en el servidor. Nunca las pongas con prefijo NEXT_PUBLIC_.

# La "service_role" key de Supabase: Settings -> API -> Project API keys -> service_role
# Es secreta, nunca la compartas ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# El PIN que usará quien esté en caja para entrar al panel /staff.
# Usa algo de 6+ dígitos o una palabra, no algo obvio como 1234.
STAFF_PIN=elige-un-pin-seguro

# Clave secreta para firmar la sesión del panel de staff.
# Genera una con: openssl rand -hex 32
STAFF_SESSION_SECRET=una-cadena-larga-y-aleatoria
